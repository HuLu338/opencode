{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  // Role-to-model bindings live here so role prompts stay provider-neutral.
  "agent": {
    "architect": {
      "model": "openrouter/anthropic/claude-sonnet-4.6",
    },
    "cheap-coder": {
      "model": "openai/gpt-5.4-mini",
    },
    "strong-coder": {
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
    },
    "reviewer": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "cost_aware": {
    "max_attempts": 3,
    "max_escalations": 1,
    "max_cost_usd": 5,
    "cheap_coder_failures_before_escalation": 2,
    "strong_coder_failures_before_human": 2,
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
