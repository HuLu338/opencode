{
  "$schema": "https://opencode.ai/config.json",
  "provider": {},
  "permission": {},
  // Role-to-model bindings live here so role prompts stay provider-neutral.
  "agent": {
    "architect": {
      "model": "openai/gpt-5.6-terra",
    },
    "cheap-coder": {
      "model": "openai/gpt-5.4-mini",
    },
    "strong-coder": {
      "model": "openai/gpt-5.5",
    },
    "reviewer": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "cost_aware": {
    // ChatGPT/Codex OAuth is covered by the subscription, so marginal token cost is zero.
    // Change this to "provider" for metered API credentials; provider/session pricing is then authoritative.
    "billing_mode": "subscription",
    "max_attempts": 3,
    "max_escalations": 1,
    "max_cost_usd": 5,
    "cheap_coder_failures_before_escalation": 2,
    "strong_coder_failures_before_human": 2,
    // Each pool is bounded and ordered from preferred to fallback.
    "model_pools": {
      "architect": ["openai/gpt-5.6-terra", "openai/gpt-5.5"],
      "cheap-coder": ["openai/gpt-5.4-mini", "openai/gpt-5.4-mini-fast"],
      "strong-coder": ["openai/gpt-5.5", "openai/gpt-5.6-terra"],
      "reviewer": ["openai/gpt-5.6-luna", "openai/gpt-5.4"],
    },
    // Docker Desktop and the local validation image are required while this is enabled.
    "sandbox": {
      "enabled": true,
      "image": "opencode-cost-aware-sandbox:local",
      "network": "none",
      "memory_mb": 4096,
      "cpus": 2,
      "pids_limit": 512,
    },
  },
  "references": {
    "effect": {
      "repository": "github.com/Effect-TS/effect-smol",
      "description": "Use for Effect v4 and effect-smol implementation details",
    },
    "opencode-local": {
      "path": "~/.local/share/opencode",
      "description": "Contains opencode logs and data",
    },
  },
  "mcp": {},
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
